#!name = YouTube
#!desc = 屏蔽推荐流和贴片广告 屏蔽播放广告 精简底栏Tab
#!icon = https://upload.wikimedia.org/wikipedia/commons/thumb/f/fc/YouTube_play_button_square_%282013-2017%29.svg/960px-YouTube_play_button_square_%282013-2017%29.svg.png?_=20190606142134

[Argument]
blockShorts = switch,true,type = boolean,tag = 短视频入口

[Rewrite]
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)/i then reject(404)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/ads/i then reject(404)
response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js", {${blockShorts}}) with tag="广告处理", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = s.youtube.com,www.youtube.com,rr*.googlevideo.com,youtubei.googleapis.com
